# --- Studio console access (REQUIRED) ---
# Without ADMIN_PASSWORD the console and the whole /api/admin surface stay closed.
ADMIN_PASSWORD='choose-a-long-random-password'
# Optional: signs session cookies. Rotating it signs everyone out.
ADMIN_SESSION_SECRET='another-long-random-string'
# Optional: move the console off the default /studio-console route (build-time).
VITE_ADMIN_PATH='/studio-console'

# --- Storage ---
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GOOGLE_SHEET_ID='your_google_sheet_id'
GOOGLE_DRIVE_FOLDER_ID='your_google_drive_folder_id'
GOOGLE_DRIVE_PUBLIC='true'

# --- SMTP ---
SMTP_HOST='smtp.example.com'
SMTP_PORT='587'
# 'true' for implicit TLS on 465, 'false' for STARTTLS on 587.
SMTP_SECURE='false'
SMTP_USER='smtp-user'
SMTP_PASS='smtp-password'
MAIL_FROM='JetClicks <no-reply@example.com>'
ADMIN_EMAIL='studio@example.com'
# Only for a local mail server with a self-signed certificate. Never in production.
# SMTP_ALLOW_SELF_SIGNED='false'

# --- Optional bot branding ---
BOT_NAME='JetClicks Assistant'

# --- Studio Google account (Drive photo uploads; service accounts can't store files) ---
# From Cloud Console -> Credentials -> OAuth client ID -> "Desktop app".
# Get the refresh token with: node scripts/get-drive-token.mjs
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
